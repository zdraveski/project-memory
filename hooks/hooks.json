{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/memory-tier.mjs", "--stop"], "timeout": 120, "statusMessage": "Saving memory" }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/memory-tier.mjs", "--stop"], "timeout": 120, "statusMessage": "Saving memory" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/memory-tier.mjs", "--stop"], "timeout": 30, "statusMessage": "Saving subagent report" }] }
    ],
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/brief.mjs", "--print"], "timeout": 30, "statusMessage": "Briefing" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [
        { "type": "command", "if": "Bash(git *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(git *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(npm publish*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(npm publish*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(pnpm publish*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(pnpm publish*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(yarn publish*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(yarn publish*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(cargo publish*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(cargo publish*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(gh release *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(gh release *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(*tools/release.mjs*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(*tools/release.mjs*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(gh pr merge*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(gh pr merge*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(docker push*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(docker push*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(*deploy*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(*deploy*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(rm -rf *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(rm -rf *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(terraform apply*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(terraform apply*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(terraform destroy*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(terraform destroy*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "Bash(kubectl delete*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(kubectl delete*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 },
        { "type": "command", "if": "PowerShell(Remove-Item *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 }
      ] },
      { "matcher": "Edit|Write|NotebookEdit|MultiEdit", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/enforce-hook.mjs"], "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|NotebookEdit", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/recall-hook.mjs"], "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/recall-hook.mjs"], "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/recall-hook.mjs"], "timeout": 1 }] }
    ],
    "PreCompact": [
      { "matcher": "manual", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/memory-tier.mjs", "--stop"], "timeout": 120, "statusMessage": "Saving before compaction" }] },
      { "matcher": "auto", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/compact-gate.mjs"], "timeout": 60, "statusMessage": "Checking before compaction" }] }
    ]
  }
}
