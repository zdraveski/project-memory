# The repo's style, for editors that read this file (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two spaces at a line's end are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
